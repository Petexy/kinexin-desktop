
# Rebuild the kwin effects via the systemd service, which runs OUTSIDE pacman's
# network sandbox (where the github clone would fail). This BLOCKS until the
# build finishes on purpose: kinexin-desktop ships in the system installer, and
# the installer must not report "finished" -- or let the user reboot -- while the
# effects are still being built.
trigger_kwin_effects_rebuild()
{
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload 2>/dev/null || true
		# No --no-block: wait for the rebuild to complete.
		systemctl start kinexin-kwin-effects-rebuild.service 2>/dev/null || true
	else
		# No running systemd (e.g. installing in a plain chroot): build in-line.
		/usr/bin/plasma-desktop-postupdate.sh || true
	fi
}

post_install()
{
	DESKTOP_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' | head -n1)
	HOME=/home/$DESKTOP_USER
	sudo cp -rf /etc/skel/.* $HOME
	sudo chown $DESKTOP_USER $HOME/.config -R
	sudo chown $DESKTOP_USER $HOME/.local/share/konsole -R
	sudo systemctl disable gdm 2>/dev/null || true
	sudo systemctl disable lightdm 2>/dev/null || true
  	sudo systemctl enable sddm
	trigger_kwin_effects_rebuild
}

post_upgrade()
{
    DESKTOP_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 {print $1}' | head -n1)
    USER_HOME=$(getent passwd "$DESKTOP_USER" | cut -d: -f6)

    TARGET_DIR="$USER_HOME/.local/share/plasma/plasmoids/org.kde.windowtitle/contents/ui"
    TARGET_FILE="$TARGET_DIR/main.qml"

    # No rebuild here: upgrades are handled by plasma-desktop-update.hook, which
    # fires once per transaction. Triggering here too would build twice.

    if [ ! -f "$TARGET_FILE" ]; then
        echo "Notice: File '$TARGET_FILE' not found. Skipping AppMenuPrivate removal."
        return 0
    fi

    sed -i '/import org\.kde\.plasma\.private\.appmenu 1\.0 as AppMenuPrivate/d' "$TARGET_FILE"
    chown "$DESKTOP_USER:$DESKTOP_USER" "$TARGET_FILE"

    echo "Successfully removed the AppMenuPrivate import from $TARGET_FILE."
}
