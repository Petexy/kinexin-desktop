[Unit]
Description=Rebuild kwin effects (glass, rounded-corners) against the current kwin
Documentation=https://github.com/Petexy
# Started synchronously from pacman scriptlets/hook (network already up), never
# enabled at boot, so no network-online.target ordering -- it would only risk
# making the blocking start wait. This unit runs outside pacman's network
# sandbox, which is what lets the github clone succeed.

[Service]
Type=oneshot
ExecStart=/usr/bin/plasma-desktop-postupdate.sh
